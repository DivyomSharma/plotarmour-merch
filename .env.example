# Copy to .env.local and uncomment what you need. Every line below is commented out on purpose:
# an unchanged copy must give a safe, empty configuration (no database, WhatsApp falls back to
# email), never a half-valid placeholder such as a fake phone number or database host.

# PostgreSQL connection string for the server runtime. Without it, /api/leads answers 503 and the
# order form falls back to WhatsApp only.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Razorpay webhook signing secret (server only). Without it, /api/webhooks/razorpay answers 503.
# RAZORPAY_WEBHOOK_SECRET=

# Set to true once the database and payments are mandatory for this deployment: a missing
# DATABASE_URL or RAZORPAY_WEBHOOK_SECRET then fails loudly instead of degrading to 503.
# REQUIRE_SERVER_ENV=true

# Maximum server PostgreSQL pool connections (optional; defaults to 3).
# DB_POOL_MAX=3

# Public WhatsApp number, digits with country code, for example 919876543210 (a real number only).
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase (future authenticated application). The service-role key is server only, never public.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Disposable PostgreSQL URL used ONLY by the opt-in real-database concurrency test. The test creates
# and drops its own database there; never point it at a server whose other data matters.
# REAL_DATABASE_URL=postgresql://postgres@127.0.0.1:56432/postgres